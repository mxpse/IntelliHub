# Resolution Hub — local prototype config
# Copy to .env and fill in the Sloan shortcut token. Never commit the real .env.

# Local server port
PORT=4173

# Sloan AI portal (the intelligence pipeline lives behind /api/shortcut/text)
SLOAN_BASE_URL=https://aaoellis.com
SLOAN_SHORTCUT_PATH=/api/shortcut/text

# The shortcut API token (server-side secret). Required to enable Sloan reasoning.
SLOAN_TOKEN=

# How the token is sent. Default header name below; set to "Authorization" to use Bearer.
SLOAN_TOKEN_HEADER=X-Shortcut-Token

# JSON body key the shortcut endpoint expects for the prompt text.
SLOAN_MESSAGE_KEY=message
